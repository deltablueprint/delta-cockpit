{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delta-cockpit",

  // Het account waarin de databases en de workers staan. Zonder dit neemt
  // wrangler het account van je laatste aanmelding, en dan wijst hij naar een
  // database die daar niet bestaat.
  "account_id": "054e2d50a3b1cee270a84aa4c6a6b3e7",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "workers_dev": true,

  "vars": { "OMGEVING": "productie" },

  // De front-end wordt als statische bestanden geserveerd; alles onder /api/
  // gaat eerst naar de worker. Onbekende paden geven index.html terug,
  // zodat de app zijn eigen routes afhandelt.
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Eén bindingnaam in alle omgevingen: env.DB.
  // Zo hoeft geen enkele regel code te weten of hij op staging of productie draait.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "delta-cockpit",
      "database_id": "7bc931ab-838a-46d0-9982-fe33c52fd1b5",
      "migrations_dir": "migrations"
    }
  ],

  "env": {
    "staging": {
      "name": "delta-cockpit-staging",
      "workers_dev": true,
      "vars": { "OMGEVING": "staging" },
      "assets": {
        "directory": "dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "delta-cockpit-staging",
          "database_id": "169a57ac-0047-4d5d-a05e-e204521727a2",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
